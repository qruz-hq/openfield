# Environment variables Openfield reads. All are optional.
# Copy this file to .env in the repo root and bun dev picks it up.
# Never commit .env: it's ignored by git for a reason.

# Where Openfield keeps your images, keys, settings and database. Default: ~/.openfield
# OPENFIELD_HOME=

# The port the server listens on, always on 127.0.0.1. Default: 4317
# OPENFIELD_PORT=

# Set to "off" to skip thumbnails and show full-size images, as if sharp couldn't load.
# OPENFIELD_THUMBNAILS=off

# API keys. Adding them in Settings > API keys is easier; these are for scripts and CI.
# A key set here overrides the one saved in Settings and is never written to disk.
# The first variable that is set wins.

# Google (Nano Banana models)
# OPENFIELD_GOOGLE_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Development and tests only.
# Answer every model call on this computer: no real key, no network, no cost.
# Any key works except one containing "invalid". A tag in a prompt plays back a failure:
# #fake:bad_key, forbidden, no_billing, rate_limited, invalid, server_error, unavailable,
# blocked, refused, no_image, foreign_asset (underscores, not hyphens).
# OPENFIELD_FAKE_PROVIDERS=1
# Run the adapter conformance suite against the real APIs. Uses your keys and costs money.
# OPENFIELD_CONFORMANCE=live
# Serve the web app from another build folder. Default: apps/web/dist
# OPENFIELD_WEB_DIST=
# Set by bun dev: the server proxies the web app from Vite instead of serving the build.
# OPENFIELD_DEV=1
