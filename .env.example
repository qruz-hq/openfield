# Environment variables Openfield reads. All are optional.
# Copy this file to .env in the repo root and bun dev picks it up.
# Never commit .env: it's ignored by git for a reason.

# Where Openfield keeps your images, keys, settings and database. Default: ~/.openfield
# OPENFIELD_HOME=

# The port the server listens on, always on 127.0.0.1. Default: 4317
# OPENFIELD_PORT=

# Set to "off" to skip thumbnails and show full-size images, as if sharp couldn't load.
# OPENFIELD_THUMBNAILS=off

# The ffmpeg that takes a video's first frame for its poster. Default: the one on your PATH.
# Set to "off" to always use the still the company sends, which is the last frame.
# OPENFIELD_FFMPEG=

# How long Openfield waits for a video, in minutes, from 10 minutes to 2 days. Default: 120
# BytePlus drops a video it hasn't finished after 2 hours either way, so only a lower value changes anything.
# OPENFIELD_VIDEO_DEADLINE_MINUTES=

# API keys. Adding them in Settings > API keys is easier; these are for scripts and CI.
# A key set here overrides the one saved in Settings and is never written to disk.
# The first variable that is set wins.

# Google (Nano Banana models)
# OPENFIELD_GOOGLE_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# OpenAI (GPT Image models)
# OPENFIELD_OPENAI_API_KEY=
# OPENAI_API_KEY=

# Higgsfield. Not HF_KEY, which belongs to Hugging Face.
# OPENFIELD_HIGGSFIELD_API_KEY=

# BytePlus (Seedance video models)
# OPENFIELD_BYTEPLUS_API_KEY=
# ARK_API_KEY=

# Development and tests only.
# Answer every model call on this computer: no real key, no network, no cost.
# Any key works except one containing "invalid". A tag in a prompt plays back an outcome:
# #fake:bad_key, forbidden, no_billing, rate_limited, invalid, server_error, unavailable,
# blocked, refused, no_image, foreign_asset, for speeds flex_busy, priority_standard,
# batch_slow, batch_partial, batch_expired, batch_failed, for restarts slow, resume_slow,
# resume_gone, and for videos failed, expired (underscores, not hyphens). The README lists
# what each one does.
# OPENFIELD_FAKE_PROVIDERS=1
# A key for the fake-only Test company and its Resumable test model. Any text works.
# OPENFIELD_FAKE_API_KEY=
# How long #fake:slow and #fake:resume_slow take, in milliseconds. Default: 30000 and 60000
# OPENFIELD_FAKE_SLOW_MS=
# Run the adapter conformance suite against the real APIs. Uses your keys and costs money.
# OPENFIELD_CONFORMANCE=live
# Serve the web app from another build folder. Default: apps/web/dist
# OPENFIELD_WEB_DIST=
# Set by bun dev: the server proxies the web app from Vite instead of serving the build.
# OPENFIELD_DEV=1
