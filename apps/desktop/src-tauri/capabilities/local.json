{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local",
  "description": "The bundled splash page that shows while the server starts.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/openfield-server", "sidecar": true, "args": ["mcp"] }]
    },
    "shell:allow-kill"
  ]
}
