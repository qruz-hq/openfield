{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Openfield",
  "version": "../../../package.json",
  "identifier": "dev.openfield.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Openfield",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#0E1012"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Openfield",
    "homepage": "https://github.com/qruz-hq/openfield",
    "category": "GraphicsAndDesign",
    "shortDescription": "Make images with your own AI keys",
    "longDescription": "Openfield is an open-source, local workspace for making images with your own AI provider keys. Everything you make stays on your computer.",
    "license": "MIT",
    "copyright": "Openfield contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/openfield-server"],
    "resources": {
      "resources/web/": "web/",
      "resources/migrations/": "migrations/",
      "resources/templates/": "templates/",
      "resources/native/": "native/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "127.0.0.1"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "recommends": ["ffmpeg", "libheif-examples"]
      },
      "rpm": {
        "recommends": ["ffmpeg", "libheif-tools"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQTcxODM4NDg1ODQzMTMKUldRVFExaElPQmluT255Nmh0YTg0aG1DV2NsNmhiY2hJQkwvNEwrdFJ3S0t1cG1IR3p2OGZiMGIK",
      "endpoints": ["https://github.com/qruz-hq/openfield/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
