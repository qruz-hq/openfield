{
  "name": "openfield",
  "private": true,
  "type": "module",
  "description": "Open-source, local, bring-your-own-key image generation workspace.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run typecheck && bun --filter @openfield/web build",
    "start": "NODE_ENV=production bun apps/server/src/index.ts",
    "mcp": "bun apps/server/src/mcp/stdio.ts",
    "typecheck": "bun --filter '*' typecheck && tsc -p e2e/tsconfig.json && tsc -p scripts/tsconfig.json",
    "db:generate": "bun --filter @openfield/db generate",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "playwright test",
    "check:bundle": "bun run scripts/check-bundle.ts",
    "seed:usage": "bun run scripts/seed-usage.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
