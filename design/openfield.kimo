, "tLFPO0": {"type":"text","parent":"GkrPE0","order":"a1","name":"Value","w":{"mode":"fill"},"content":"Single 4 px cells (3 px squares, 1 px gaps) across the whole card, about two for every three cells. Each drifts in a slow loop of under 2 cells around its own home, so the swarm shimmers without going anywhere.","grow":"fixed-width","style":{"font":"Inter","size":12,"weight":400,"lineHeight":1.5},"fill":{"$ref":"text-secondary"}}

